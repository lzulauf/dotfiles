#compdef worktree

_worktree () {
  # Existing worktrees for the current client + the command options.
  local -a wts
  wts=( "${CONTEXT_MAIN_WORKTREE:-main}" ${HOME}/code/worktrees/${CLIENT_NAME}/*(/N:t) )
  _alternative \
    "worktrees:worktree:(${wts})" \
    'options:option:(--list --status --add --rm --main --help)'
}
_worktree "$@"
