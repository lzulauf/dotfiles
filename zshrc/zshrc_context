# The (client, worktree) context system, sourced from zshrc_general.
# Load order matters: this must load before zshrc_tmux (which overrides the
# _context_persist seam); company files (zshrc_humble, ...) source
# zshrc_general first, then override _context_client_root. Completions live
# in completion/_client and completion/_worktree.

# =============================================================================
# Client / worktree context
#
# The active context is a pair (client, worktree). `worktree` defaults to the
# sentinel $CONTEXT_MAIN_WORKTREE, meaning the primary checkout. Both `client`
# and `worktree` funnel through _context_set so there is a single place that
# sets env vars, persists state, and cd's.
#
# State scopes:
#   ~/.client              global default client (bare name), unchanged
#   ~/.client_worktrees    per-client remembered worktree ("<client>\t<wt>")
#   tmux session_client / session_worktree   per-session current pair (see
#                          zshrc_tmux, which overrides the _context_persist seam)
# =============================================================================

# Where linked worktrees live, and the sentinel name for the primary checkout.
# Under ~/code so they stay derivable and inside CLAUDE_MOUNT_DIR.
export WORKTREE_ROOT="${WORKTREE_ROOT:-$HOME/code/worktrees}"
export CONTEXT_MAIN_WORKTREE="${CONTEXT_MAIN_WORKTREE:-main}"

# Where planning documents live: a single global tree, sibling to the clients
# and the worktree tree under ~/code. Plans are repo-agnostic here and record
# their target repo/worktree in their own Context section (see plan-use skill).
export PLANS_ROOT="${PLANS_ROOT:-$HOME/code/plans}"
CLIENT_WORKTREE_MAP=$HOME/.client_worktrees

# Company hook: resolve the primary-checkout root for a client into CLIENT_DIR
# and run any side effects. Overridable per-company (see zshrc_humble).
function _context_client_root {
  export CLIENT_DIR=$HOME/code/$1
  # HACK!! aurelia needs corepack enabled.
  if [[ $1 == aurelia ]]; then
    corepack enable
  fi
}

# Persistence seam. Default is a no-op (the file writes happen in _context_set);
# zshrc_tmux overrides this to also mirror the pair into the tmux session env.
function _context_persist { : }

# Read the remembered worktree for a client (echoes the sentinel if none).
function _context_worktree_get {
  local wt=""
  if [[ -f $CLIENT_WORKTREE_MAP ]]; then
    wt=$(awk -F'\t' -v c="$1" '$1==c {print $2; exit}' $CLIENT_WORKTREE_MAP)
  fi
  echo ${wt:-$CONTEXT_MAIN_WORKTREE}
}

# Persist the remembered worktree for a client into the map (upsert).
function _context_worktree_set {
  local tmp
  tmp=$(mktemp)
  if [[ -f $CLIENT_WORKTREE_MAP ]]; then
    awk -F'\t' -v c="$1" '$1!=c' $CLIENT_WORKTREE_MAP > $tmp
  fi
  printf '%s\t%s\n' "$1" "$2" >> $tmp
  mv $tmp $CLIENT_WORKTREE_MAP
}

# Core: set the active (client, worktree) context.
#   _context_set <client> [worktree] [--nocd]
# If <worktree> is omitted, the client's remembered worktree is restored.
function _context_set {
  local do_cd=1 arg client wt=""
  local -a rest
  for arg in "$@"; do
    case "$arg" in
      --nocd) do_cd=0 ;;
      *) rest+=("$arg") ;;
    esac
  done
  client=$rest[1]
  wt=$rest[2]
  [[ -z $client ]] && return 1

  # Guard: the worktree and plans storage dirs are siblings of clients under
  # ~/code and are not selectable as clients.
  if [[ $client == worktrees ]]; then
    echo "client: 'worktrees' is reserved (worktree storage dir)" >&2
    return 1
  fi
  if [[ $client == plans ]]; then
    echo "client: 'plans' is reserved (plans storage dir)" >&2
    return 1
  fi

  export CLIENT_NAME=$client
  _context_client_root $client            # sets CLIENT_DIR (+ company side effects)

  # Resolve worktree: explicit arg, else remembered, else sentinel.
  [[ -z $wt ]] && wt=$(_context_worktree_get $client)

  if [[ $wt == $CONTEXT_MAIN_WORKTREE ]]; then
    export WORKTREE_DIR=$CLIENT_DIR
  else
    export WORKTREE_DIR=$WORKTREE_ROOT/$client/$wt
    if [[ ! -d $WORKTREE_DIR ]]; then
      echo "worktree '$wt' for '$client' is gone; using $CONTEXT_MAIN_WORKTREE" >&2
      wt=$CONTEXT_MAIN_WORKTREE
      export WORKTREE_DIR=$CLIENT_DIR
    fi
  fi
  export WORKTREE_NAME=$wt

  # Persist: global default, per-client memory, then session seam.
  echo $CLIENT_NAME > ~/.client
  _context_worktree_set $client $wt
  _context_persist

  if [[ $do_cd == 1 ]]; then
    cd $WORKTREE_DIR
  fi
}

# Backwards-compat shim for anything that still calls client_internal.
function client_internal { _context_set "$@" }

# Switch the active client (restores that client's remembered worktree).
function client {
  _context_set "$@"
}

# ---- worktree command -------------------------------------------------------

function _worktree_dir { echo $WORKTREE_ROOT/$CLIENT_NAME/$1 }

function _worktree_list {
  if [[ -z $CLIENT_NAME ]]; then echo "worktree: no client set" >&2; return 1; fi
  local base=$WORKTREE_ROOT/$CLIENT_NAME d name marker
  [[ $WORKTREE_NAME == $CONTEXT_MAIN_WORKTREE ]] && marker="*" || marker=" "
  printf '%s %-20s %s\n' "$marker" "$CONTEXT_MAIN_WORKTREE" "$CLIENT_DIR"
  if [[ -d $base ]]; then
    for d in $base/*(N/); do
      name=${d:t}
      [[ $WORKTREE_NAME == $name ]] && marker="*" || marker=" "
      printf '%s %-20s %s\n' "$marker" "$name" "$d"
    done
  fi
}

# Compute one status row as raw tab-separated fields (NO padding/color — the
# render pass owns alignment and color once all rows are known):
#   marker <tab> name <tab> branch <tab> local-text <tab> local-state
#          <tab> upstream-text <tab> upstream-state
#   $1 name  $2 dir  $3 uflag (git status -u* mode)  $4 repo (for the * marker)
# local defaults to tracked changes only (-uno): the untracked scan walks the
# whole tree, so warm it costs ~15x tracked-only on a big repo (~1.7s vs ~0.1s on
# servers), while tracked staged/unstaged edits are what "uncommitted work" really
# means; `-u` opts back into the full scan. (Both modes also pay a one-time cold
# index refresh — several seconds on a slow mount — on the first status of the
# session.) Divergence is read from the tracking ref (last fetch), no network, ~6ms.
function _worktree_status_row {
  local name=$1 dir=$2 uflag=$3 repo=$4 marker branch dirty dstate n counts behind ahead upstream ustate
  [[ $repo == $CLIENT_NAME && $name == $WORKTREE_NAME ]] && marker="*" || marker=" "

  branch=$(git -C $dir symbolic-ref --quiet --short HEAD 2>/dev/null) || branch="(detached)"

  n=$(git -C $dir status --porcelain $uflag 2>/dev/null | grep -c .)
  if [[ $n -gt 0 ]]; then dirty="$n changed"; dstate=dirty; else dirty="clean"; dstate=clean; fi

  if counts=$(git -C $dir rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null); then
    read -r behind ahead <<< "$counts"
    if [[ $ahead == 0 && $behind == 0 ]]; then upstream="up to date"; ustate=sync
    else upstream="↑$ahead ↓$behind"; ustate=diverged; fi
  else
    upstream="no upstream"; ustate=none
  fi

  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$marker" "$name" "$branch" "$dirty" "$dstate" "$upstream" "$ustate"
}

# Per-worktree status: uncommitted changes and divergence from upstream.
#   worktree --status            current client's worktrees
#   worktree --status --all      every git repo under ~/code
#   worktree --status -u         include untracked files (slower, full scan)
# Rows are computed in parallel (each git call is independent) so wall-clock is
# the slowest single row, not the sum — this is what keeps --all usable. Then a
# single render pass measures column widths and colors LOCAL/UPSTREAM (green =
# clean / up to date, yellow = changes / diverged, gray = no upstream).
function _worktree_status {
  # Silence job-control chatter ([N] pid / [N] done) from the parallel fan-out;
  # local_options restores the shell's monitor setting on return.
  setopt local_options no_monitor
  local all=0 uflag="-uno" arg
  for arg in "$@"; do
    case $arg in
      -a|--all)       all=1 ;;
      -u|--untracked) uflag="-unormal" ;;   # non-empty: an empty arg would vanish and shift the row's positionals
      *) echo "worktree: unknown status option $arg" >&2; return 1 ;;
    esac
  done

  local -a repos
  if [[ $all == 1 ]]; then
    local d nm
    for d in $HOME/code/*(N/); do
      nm=${d:t}
      [[ $nm == worktrees || $nm == plans ]] && continue
      git -C $d rev-parse --git-dir >/dev/null 2>&1 && repos+=($nm)
    done
  else
    if [[ -z $CLIENT_NAME ]]; then echo "worktree: no client set" >&2; return 1; fi
    repos=($CLIENT_NAME)
  fi

  local tmp; tmp=$(mktemp -d)
  local -i idx=0
  local -a order pids
  local repo repodir base wt

  # Fan out: each row writes its own indexed file; `order` records the
  # interleaving of repo-group headers (H:) and row files (R:) for replay.
  for repo in $repos; do
    repodir=$HOME/code/$repo
    [[ $all == 1 ]] && order+=("H:$repo")
    (( idx += 1 ))
    _worktree_status_row $CONTEXT_MAIN_WORKTREE $repodir $uflag $repo > $tmp/$idx & pids+=($!)
    order+=("R:$idx")
    base=$WORKTREE_ROOT/$repo
    if [[ -d $base ]]; then
      for wt in $base/*(N/); do
        (( idx += 1 ))
        _worktree_status_row ${wt:t} $wt $uflag $repo > $tmp/$idx & pids+=($!)
        order+=("R:$idx")
      done
    fi
  done
  wait $pids

  # Colors only when writing to a terminal (never into a pipe/file).
  local grn ylw gry bld rst
  if [[ -t 1 ]]; then grn=$'\e[32m'; ylw=$'\e[33m'; gry=$'\e[90m'; bld=$'\e[1m'; rst=$'\e[0m'; fi

  # Pass 1: measure columns (seed with header-label widths).
  local -i wname=8 wbranch=6 wlocal=5
  local e line m nm br dt ds up us
  for e in $order; do
    [[ $e == R:* ]] || continue
    line=$(<$tmp/${e#R:})
    IFS=$'\t' read -r m nm br dt ds up us <<< "$line"
    (( ${#nm} > wname ))   && wname=${#nm}
    (( ${#br} > wbranch )) && wbranch=${#br}
    (( ${#dt} > wlocal ))  && wlocal=${#dt}
  done

  # Pass 2: render aligned + colored.
  local nf="%-${wname}s" bf="%-${wbranch}s" lf="%-${wlocal}s" lc uc
  printf "  ${nf}  ${bf}  ${lf}  %s\n" WORKTREE BRANCH LOCAL UPSTREAM
  for e in $order; do
    if [[ $e == H:* ]]; then print -r -- "${bld}${e#H:}${rst}"; continue; fi
    line=$(<$tmp/${e#R:})
    IFS=$'\t' read -r m nm br dt ds up us <<< "$line"
    [[ $ds == clean ]] && lc=$grn || lc=$ylw
    case $us in sync) uc=$grn ;; diverged) uc=$ylw ;; *) uc=$gry ;; esac
    printf "%s ${nf}  ${bf}  ${lc}${lf}${rst}  ${uc}%s${rst}\n" "$m" "$nm" "$br" "$dt" "$up"
  done
  rm -rf $tmp
}

function _worktree_switch {
  local wt=$1 dir
  # The sentinel name isn't a real dir; treat it as "back to the main checkout".
  if [[ $wt == $CONTEXT_MAIN_WORKTREE ]]; then
    _context_set $CLIENT_NAME $CONTEXT_MAIN_WORKTREE
    return
  fi
  dir=$(_worktree_dir $wt)
  if [[ ! -d $dir ]]; then
    echo "worktree: '$wt' does not exist for '$CLIENT_NAME'." >&2
    echo "  create it with: worktree --add $wt [branch]" >&2
    return 1
  fi
  _context_set $CLIENT_NAME $wt
}

# Wire a freshly-created worktree's branch to a remote so push/pull/status work
# without a manual --set-upstream. If origin/<branch> already exists we track it;
# otherwise we pre-set tracking config so the first push lands on origin/<branch>
# (what push.autoSetupRemote does, but scoped to worktrees we create here).
function _worktree_setup_upstream {
  local dir=$1 branch remote
  branch=$(git -C $dir symbolic-ref --quiet --short HEAD 2>/dev/null) || return 0
  # Leave an already-tracking branch alone.
  git -C $dir config --get "branch.$branch.merge" >/dev/null 2>&1 && return 0

  remote=origin
  git -C $dir remote get-url $remote >/dev/null 2>&1 || remote=$(git -C $dir remote | head -1)
  [[ -z $remote ]] && return 0

  if git -C $dir rev-parse --quiet --verify "refs/remotes/$remote/$branch" >/dev/null 2>&1; then
    git -C $dir branch --set-upstream-to="$remote/$branch" "$branch" >/dev/null
  else
    git -C $dir config "branch.$branch.remote" "$remote"
    git -C $dir config "branch.$branch.merge" "refs/heads/$branch"
  fi
  echo "worktree: tracking $remote/$branch" >&2
}

function _worktree_add {
  local wt=$1 branch=$2 dir
  if [[ -z $wt ]]; then echo "usage: worktree --add <name> [branch]" >&2; return 1; fi
  if [[ -z $CLIENT_DIR ]]; then echo "worktree: no client set" >&2; return 1; fi
  dir=$(_worktree_dir $wt)
  if [[ -d $dir ]]; then echo "worktree: '$wt' already exists" >&2; return 1; fi
  mkdir -p ${dir:h}
  if [[ -n $branch ]]; then
    git -C $CLIENT_DIR worktree add $dir $branch || return 1
  else
    git -C $CLIENT_DIR worktree add $dir || return 1
  fi
  _worktree_setup_upstream $dir
  _context_set $CLIENT_NAME $wt
}

function _worktree_remove {
  local wt=$1 dir
  if [[ -z $wt ]]; then echo "usage: worktree --rm <name>" >&2; return 1; fi
  if [[ $wt == $CONTEXT_MAIN_WORKTREE ]]; then echo "worktree: cannot remove the main checkout" >&2; return 1; fi
  dir=$(_worktree_dir $wt)
  git -C $CLIENT_DIR worktree remove $dir || return 1
  # Drop back to main if we were standing on the removed worktree.
  if [[ $WORKTREE_NAME == $wt ]]; then
    _context_set $CLIENT_NAME $CONTEXT_MAIN_WORKTREE
  fi
}

function _worktree_help {
  cat <<EOF
worktree — switch between git worktrees of the current client ($CLIENT_NAME)

usage:
  worktree                     list worktrees (also -l, --list)
  worktree -s, --status        local + upstream status per worktree
      -a, --all                ... across every repo under ~/code
      -u, --untracked          ... including untracked files (slower)
  worktree <name>              switch to an existing worktree
  worktree $CONTEXT_MAIN_WORKTREE, -, --main   switch back to the primary checkout
  worktree --add <name> [branch]   create a worktree (tracking origin), then switch
  worktree --rm <name>         remove a worktree (also --remove)
  worktree -h, --help          show this help

Short flags can be bundled: \`worktree -sua\` == \`worktree -s -u -a\`.
Worktrees live under $WORKTREE_ROOT/<client>/<name>.
"$CONTEXT_MAIN_WORKTREE" is the sentinel for the primary checkout (\$CLIENT_DIR),
not a directory on disk.
EOF
}

# Switch between worktrees of the current client. See `worktree --help`.
function worktree {
  # Expand a bundled short-flag cluster (e.g. -sua -> -s -u -a) so flags can be
  # combined; the leading letter is the command. Only single-dash clusters of 2+
  # letters are touched — long options (--all) and bare `-` pass through.
  if [[ $1 == -[A-Za-z][A-Za-z]* ]]; then
    local bundle=${1#-} i
    local -a rest
    for (( i = 1; i <= ${#bundle}; i++ )); do rest+=("-${bundle[i]}"); done
    shift
    set -- "${rest[@]}" "$@"
  fi

  local cmd=$1
  case "$cmd" in
    ""|-l|--list)  _worktree_list ;;
    -s|--status|status)  shift; _worktree_status "$@" ;;
    -h|--help)     _worktree_help ;;
    -|--main)      _context_set $CLIENT_NAME $CONTEXT_MAIN_WORKTREE ;;
    --add)         shift; _worktree_add "$@" ;;
    --rm|--remove) shift; _worktree_remove "$@" ;;
    -*)            echo "worktree: unknown option $cmd" >&2; _worktree_help >&2; return 1 ;;
    *)             _worktree_switch "$cmd" ;;
  esac
}

alias wt="worktree"
