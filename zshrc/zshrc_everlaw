export PATH=$PATH:${HOME}/bin:${HOME}/.local/bin:${HOME}/.cargo/bin:${HOME}/.pyenv/bin

export CLAUDE_MOUNT_DIR=~/code
export CLAUDE_WORKSPACE=servers

source $( dirname ${(%):-%N} )/zshrc_general
source $( dirname ${(%):-%N} )/zshrc_virtualenv
# source $( dirname ${(%):-%N} )/zshrc_k8s

# Enable bash completion commands (e.g. `complete -c`)
autoload bashcompinit && bashcompinit

# This is invoked by ~/.zshrc for now because setup_dev_machine puts it there
# export NVM_LAZY_LOAD=true
# source ~/.zsh-nvm/zsh-nvm.plugin.zsh

export NVM_DIR="$HOME/.nvm"
# Or better yet, use the --no-use option.
# Requires calling `nvm use default` before commands work, though.
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" # This loads nvm
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# export VIRTUAL_ENV_DISABLE_PROMPT=1

# TODO neovim setup
# export NVIM_PY2_PROG="/Users/luke.zulauf/.local/share/virtualenvs/nvim2j   /bin/python2"
# export NVIM_PY3_PROG="/Users/luke.zulauf/.local/share/virtualenvs/nvim3-DjXriX1B/bin/python3"

# export SHELL=/usr/local/bin/zsh
export EDITOR=/snap/bin/nvim

# export GID="$GID"
# export UID="$UID"
# export DOCKER_BUILDKIT=1
# export COMPOSE_DOCKER_CLI_BUILD=1

export RUFF_OUTPUT_FORMAT=concise

alias vim='nvim'

if [[ -e ~/.zshrc_secrets ]]; then
  source ~/.zshrc_secrets
fi

# Pyenv
export PYENV_ROOT="$HOME/.pyenv"
eval "$(pyenv init -)"
eval "$(pyenv virtualenv-init -)"


#alias docker-killall="docker kill `docker ps -q`"
#alias docker-rmall="docker rm `docker ps -a -q`"


# Aliases for initializing yubikey ssh support (need to run after each reboot)
alias ykf='ssh-add -e /usr/lib/x86_64-linux-gnu/libykcs11.so && ssh-add -s /usr/lib/x86_64-linux-gnu/libykcs11.so'

# Set up alsa config path for pygame.midi
export ALSA_CONFIG_PATH="/usr/share/alsa/alsa.conf"

function input-bridge-start {
  ~/.pyenv/versions/input_bridge/bin/input-bridge --config ~/Dropbox/code/input_bridge/config.yml -qqq  &
}


# Set client
# Do this at the end in case we have anything that triggers
export CLIENT_DIR=
if [[ -e ~/.client ]]; then
   client `cat ~/.client` --nocd
fi
