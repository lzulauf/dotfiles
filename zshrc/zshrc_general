# =============================================================================
# Client / worktree context
#
# The active context is a pair (client, worktree). `worktree` defaults to the
# sentinel $CONTEXT_MAIN_WORKTREE, meaning the primary checkout. Both `client`
# and `worktree` funnel through _context_set so there is a single place that
# sets env vars, persists state, and cd's.
#
# State scopes:
#   ~/.client              global default client (bare name), unchanged
#   ~/.client_worktrees    per-client remembered worktree ("<client>\t<wt>")
#   tmux session_client / session_worktree   per-session current pair (see
#                          zshrc_tmux, which overrides the _context_persist seam)
# =============================================================================

# Where linked worktrees live, and the sentinel name for the primary checkout.
# Under ~/code so they stay derivable and inside CLAUDE_MOUNT_DIR.
: ${WORKTREE_ROOT:=$HOME/code/worktrees}
: ${CONTEXT_MAIN_WORKTREE:=main}
CLIENT_WORKTREE_MAP=$HOME/.client_worktrees

# Company hook: resolve the primary-checkout root for a client into CLIENT_DIR
# and run any side effects. Overridable per-company (see zshrc_humble).
function _context_client_root {
  export CLIENT_DIR=$HOME/code/$1
  # HACK!! aurelia needs corepack enabled.
  if [[ $1 == aurelia ]]; then
    corepack enable
  fi
}

# Persistence seam. Default is a no-op (the file writes happen in _context_set);
# zshrc_tmux overrides this to also mirror the pair into the tmux session env.
function _context_persist { : }

# Read the remembered worktree for a client (echoes the sentinel if none).
function _context_worktree_get {
  local wt=""
  if [[ -f $CLIENT_WORKTREE_MAP ]]; then
    wt=$(awk -F'\t' -v c="$1" '$1==c {print $2; exit}' $CLIENT_WORKTREE_MAP)
  fi
  echo ${wt:-$CONTEXT_MAIN_WORKTREE}
}

# Persist the remembered worktree for a client into the map (upsert).
function _context_worktree_set {
  local tmp
  tmp=$(mktemp)
  if [[ -f $CLIENT_WORKTREE_MAP ]]; then
    awk -F'\t' -v c="$1" '$1!=c' $CLIENT_WORKTREE_MAP > $tmp
  fi
  printf '%s\t%s\n' "$1" "$2" >> $tmp
  mv $tmp $CLIENT_WORKTREE_MAP
}

# Core: set the active (client, worktree) context.
#   _context_set <client> [worktree] [--nocd]
# If <worktree> is omitted, the client's remembered worktree is restored.
function _context_set {
  local do_cd=1 arg client wt=""
  local -a rest
  for arg in "$@"; do
    case "$arg" in
      --nocd) do_cd=0 ;;
      *) rest+=("$arg") ;;
    esac
  done
  client=$rest[1]
  wt=$rest[2]
  [[ -z $client ]] && return 1

  # Guard: the worktree storage dir is a sibling of clients under ~/code.
  if [[ $client == worktrees ]]; then
    echo "client: 'worktrees' is reserved (worktree storage dir)" >&2
    return 1
  fi

  export CLIENT_NAME=$client
  _context_client_root $client            # sets CLIENT_DIR (+ company side effects)

  # Resolve worktree: explicit arg, else remembered, else sentinel.
  [[ -z $wt ]] && wt=$(_context_worktree_get $client)

  if [[ $wt == $CONTEXT_MAIN_WORKTREE ]]; then
    export WORKTREE_DIR=$CLIENT_DIR
  else
    export WORKTREE_DIR=$WORKTREE_ROOT/$client/$wt
    if [[ ! -d $WORKTREE_DIR ]]; then
      echo "worktree '$wt' for '$client' is gone; using $CONTEXT_MAIN_WORKTREE" >&2
      wt=$CONTEXT_MAIN_WORKTREE
      export WORKTREE_DIR=$CLIENT_DIR
    fi
  fi
  export WORKTREE_NAME=$wt

  # Persist: global default, per-client memory, then session seam.
  echo $CLIENT_NAME > ~/.client
  _context_worktree_set $client $wt
  _context_persist

  if [[ $do_cd == 1 ]]; then
    cd $WORKTREE_DIR
  fi
}

# Backwards-compat shim for anything that still calls client_internal.
function client_internal { _context_set "$@" }

# Switch the active client (restores that client's remembered worktree).
function client {
  _context_set "$@"
}

# ---- worktree command -------------------------------------------------------

function _worktree_dir { echo $WORKTREE_ROOT/$CLIENT_NAME/$1 }

function _worktree_list {
  if [[ -z $CLIENT_NAME ]]; then echo "worktree: no client set" >&2; return 1; fi
  local base=$WORKTREE_ROOT/$CLIENT_NAME d name marker
  [[ $WORKTREE_NAME == $CONTEXT_MAIN_WORKTREE ]] && marker="*" || marker=" "
  printf '%s %-20s %s\n' "$marker" "$CONTEXT_MAIN_WORKTREE" "$CLIENT_DIR"
  if [[ -d $base ]]; then
    for d in $base/*(N/); do
      name=${d:t}
      [[ $WORKTREE_NAME == $name ]] && marker="*" || marker=" "
      printf '%s %-20s %s\n' "$marker" "$name" "$d"
    done
  fi
}

function _worktree_switch {
  local wt=$1 dir
  # The sentinel name isn't a real dir; treat it as "back to the main checkout".
  if [[ $wt == $CONTEXT_MAIN_WORKTREE ]]; then
    _context_set $CLIENT_NAME $CONTEXT_MAIN_WORKTREE
    return
  fi
  dir=$(_worktree_dir $wt)
  if [[ ! -d $dir ]]; then
    echo "worktree: '$wt' does not exist for '$CLIENT_NAME'." >&2
    echo "  create it with: worktree --add $wt [branch]" >&2
    return 1
  fi
  _context_set $CLIENT_NAME $wt
}

function _worktree_add {
  local wt=$1 branch=$2 dir
  if [[ -z $wt ]]; then echo "usage: worktree --add <name> [branch]" >&2; return 1; fi
  if [[ -z $CLIENT_DIR ]]; then echo "worktree: no client set" >&2; return 1; fi
  dir=$(_worktree_dir $wt)
  if [[ -d $dir ]]; then echo "worktree: '$wt' already exists" >&2; return 1; fi
  mkdir -p ${dir:h}
  if [[ -n $branch ]]; then
    git -C $CLIENT_DIR worktree add $dir $branch || return 1
  else
    git -C $CLIENT_DIR worktree add $dir || return 1
  fi
  _context_set $CLIENT_NAME $wt
}

function _worktree_remove {
  local wt=$1 dir
  if [[ -z $wt ]]; then echo "usage: worktree --rm <name>" >&2; return 1; fi
  if [[ $wt == $CONTEXT_MAIN_WORKTREE ]]; then echo "worktree: cannot remove the main checkout" >&2; return 1; fi
  dir=$(_worktree_dir $wt)
  git -C $CLIENT_DIR worktree remove $dir || return 1
  # Drop back to main if we were standing on the removed worktree.
  if [[ $WORKTREE_NAME == $wt ]]; then
    _context_set $CLIENT_NAME $CONTEXT_MAIN_WORKTREE
  fi
}

function _worktree_help {
  cat <<EOF
worktree — switch between git worktrees of the current client ($CLIENT_NAME)

usage:
  worktree                     list worktrees (also -l, --list)
  worktree <name>              switch to an existing worktree
  worktree $CONTEXT_MAIN_WORKTREE, -, --main   switch back to the primary checkout
  worktree --add <name> [branch]   create a worktree, then switch to it
  worktree --rm <name>         remove a worktree (also --remove)
  worktree -h, --help          show this help

Worktrees live under $WORKTREE_ROOT/<client>/<name>.
"$CONTEXT_MAIN_WORKTREE" is the sentinel for the primary checkout (\$CLIENT_DIR),
not a directory on disk.
EOF
}

# Switch between worktrees of the current client. See `worktree --help`.
function worktree {
  local cmd=$1
  case "$cmd" in
    ""|-l|--list)  _worktree_list ;;
    -h|--help)     _worktree_help ;;
    -|--main)      _context_set $CLIENT_NAME $CONTEXT_MAIN_WORKTREE ;;
    --add)         shift; _worktree_add "$@" ;;
    --rm|--remove) shift; _worktree_remove "$@" ;;
    -*)            echo "worktree: unknown option $cmd" >&2; _worktree_help >&2; return 1 ;;
    *)             _worktree_switch "$cmd" ;;
  esac
}

alias wt="worktree"

function tmux_session {
  tmux has-session -t $1
  if [ $? != 0 ]; then
    tmux new-session -s $1 -d "${@:2}"
  fi
  tmux switch-client -t $1
}

